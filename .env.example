# ─────────────────────────────────────────────────────────────────────
# Graver Studio — env example
# Copy to .env.local for local development. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────────

# ─── Translation (Gemini) ────────────────────────────────────────────
# Used by scripts/translate-page.mjs and the GitHub Action.
# Get it from https://aistudio.google.com/app/apikey
# In GitHub: Settings → Secrets and variables → Actions → New repository secret → GEMINI_API_KEY
GEMINI_API_KEY=

# Optional fallback name (some Google docs use this)
# GOOGLE_API_KEY=

# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ─── Admin Tools (SEO Cockpit, Translate UI) ────────────────────────
# A shared password (≥8 chars). Anyone with this token can view the
# read-only SEO dashboard at /admin-tools/. Without this token set,
# /admin-tools/* returns "not configured".
# Set in Cloudflare Pages → Settings → Environment Variables → Production (Secret).
ADMIN_TOOLS_TOKEN=

# ─── Keystatic GitHub auth (already set in production) ───────────────
# These live in wrangler.toml [vars] (non-secret) + Cloudflare Pages
# secrets (KEYSTATIC_GITHUB_CLIENT_SECRET, KEYSTATIC_SECRET).
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=

# Force GitHub storage in `next dev` (useful for testing OAuth flow).
# Leave unset for normal local development with `kind: 'local'`.
# KEYSTATIC_GITHUB_FORCE=1
